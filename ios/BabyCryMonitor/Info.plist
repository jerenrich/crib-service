<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Crib Service</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>NSMicrophoneUsageDescription</key><string>Listen for sustained crying-like sound. Audio is processed on this iPhone, never recorded or transmitted.</string>
<key>NSAlarmKitUsageDescription</key><string>Create silent-tone alarms for crying or a lost Listener connection when you enable Silent Watch alarms, and run alarm tests you request.</string>
<key>UIBackgroundModes</key><array><string>audio</string><string>fetch</string><string>remote-notification</string></array>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.jordanerenrich.cribservice.benchmark.refresh</string></array>
<key>UILaunchScreen</key><dict/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>BackendURL</key><string>$(BACKEND_URL)</string>
<key>ITSAppUsesNonExemptEncryption</key><false/>
</dict></plist>
